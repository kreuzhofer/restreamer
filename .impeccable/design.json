  "narrative": {
    "northStar": "Restrained production studio",
    "overview": "The accepted prototype keeps application controls restrained and lets broadcast media carry expressive themes. The production implementation preserves that direction with charcoal surfaces, mint actions, labelled navigation and compact rows. This is an operational workspace, with content previews providing the visual emphasis.\n\nThis inventory describes the production source, not a new aesthetic direction or a claim of complete release acceptance. PRODUCT.md and the approved UX plan retain authority over playback, selection and desktop/mobile contracts.",
    "keyCharacteristics": [
      "Persistent labelled navigation; underlined local views; filled task commands.",
      "Flat sections and list dividers, with containment reserved for forms, media and dialogs.",
      "Readable status text and explicit next-use versus playing-now identities."
    ],
    "rules": [
      {
        "name": "The Navigation and Command Rule",
        "body": "Page links, local view switches and task commands retain distinct visual treatments.",
        "section": "colors"
      },
      {
        "name": "The Media Owns the Theme Rule",
        "body": "Expressive Arcade and Neon artwork belongs inside media previews; application controls retain the studio palette.",
        "section": "colors"
      },
      {
        "name": "The Flat Section Rule",
        "body": "Ordinary sections use whitespace and dividers; do not give every section a raised card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve semantic page links and their current-page state; use buttons for commands and local state changes.",
      "Do keep supporting status in words, including selected-for-next-use and playing-now distinctions.",
      "Do use bounded grid tracks, wrapping text and contained clip scrolling.",
      "Do preserve visible keyboard focus, reduced-motion overrides and the desktop-only authoring boundary."
    ],
    "donts": [
      "Don't use content-theme styling as application chrome.",
      "Don't turn every list row or section into an elevated card.",
      "Don't imply generation selected a result or replaced current playback.",
      "Don't copy legacy specificity, small helper text or inconsistent focus treatments into new components."
    ]
  }
}
