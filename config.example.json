{
  "listen": ":1935",
  "health_listen": ":8080",
  "application": "live",
  "stream_key": "${INGEST_STREAM_KEY}",
  "queue_bytes": 16777216,
  "dashboard_username": "${DASHBOARD_USERNAME}",
  "dashboard_password": "${DASHBOARD_PASSWORD}",
  "state_file": "${TARGET_STATE_FILE}",
  "library_directory": "${LIBRARY_DIRECTORY}",
  "library_upload_mib": 4096,
  "brb": {
    "enabled": "${BRB_ENABLED}",
    "directory": "${BRB_DIRECTORY}",
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "sample_rate": 48000
  },
  "targets": [
    {
      "name": "twitch",
      "enabled": "${TWITCH_ENABLED}",
      "url": "${TWITCH_SERVER}",
      "stream_key": "${TWITCH_STREAM_KEY}"
    },
    {
      "name": "youtube",
      "enabled": "${YOUTUBE_ENABLED}",
      "url": "${YOUTUBE_SERVER}",
      "stream_key": "${YOUTUBE_STREAM_KEY}"
    }
  ]
}
