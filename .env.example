# Generate your own ingest key: openssl rand -hex 24
INGEST_STREAM_KEY=

# Set both to enable the dashboard. HTTP only; use your HTTPS reverse proxy.
# For passwords containing $, use single quotes in this .env file.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Keep broadcasts live during OBS disconnects. Profile and assets can be
# selected in the dashboard. Defaults: 1080p30, AAC-LC stereo at 48 kHz.
BRB_ENABLED=false

# Configure destination servers and keys in desktop Settings.

# Optional host bindings. RTMP input itself is unencrypted.
RTMP_BIND_ADDRESS=0.0.0.0
STATUS_PORT=8080
STATUS_BIND_ADDRESS=127.0.0.1

# Optional: pin a published image to a commit tag or digest.
RESTREAMER_IMAGE=ghcr.io/kreuzhofer/restreamer:main
