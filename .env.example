# Generate your own ingest key: openssl rand -hex 24
INGEST_STREAM_KEY=

# Set both to enable the dashboard. HTTP only; use your HTTPS reverse proxy.
# For passwords containing $, use single quotes in this .env file.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Copy the server URL from Twitch/OBS (without the stream key).
# Example server URL: rtmp://live.twitch.tv/app
TWITCH_ENABLED=true
TWITCH_SERVER=rtmp://live.twitch.tv/app
# Leave the key empty to disable Twitch, or set TWITCH_ENABLED=false.
TWITCH_STREAM_KEY=

YOUTUBE_ENABLED=true
YOUTUBE_SERVER=rtmps://a.rtmps.youtube.com/live2
# Leave the key empty to disable YouTube, or set YOUTUBE_ENABLED=false.
YOUTUBE_STREAM_KEY=

# Optional host bindings. RTMP input itself is unencrypted.
RTMP_BIND_ADDRESS=0.0.0.0
STATUS_PORT=8080
STATUS_BIND_ADDRESS=127.0.0.1

# Optional: pin a published image to a commit tag or digest.
RESTREAMER_IMAGE=ghcr.io/kreuzhofer/restreamer:main
